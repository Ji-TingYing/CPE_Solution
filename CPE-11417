//GCD (UVA 11417)

#include <iostream>

using namespace std;

int GCD(int x, int y)
{
    if(y == 0) return x;
    else return GCD(y, x % y);
}

int main()
{
    int N;
    
    while(cin >> N && N != 0)
    {
        int G = 0;

        for(int i = 1; i < N; i++)
        {
            for(int j = i + 1; j <= N; j++)
            {
                G += GCD(i, j);
            }
        }
        cout << G << endl;
    }
}
