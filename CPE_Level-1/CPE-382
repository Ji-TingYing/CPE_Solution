// Perfection (UVA 382)

#include <iostream>

using namespace std;

int main()
{
    int n;
    cout << "PERFECTION OUTPUT" << endl;
    while(cin >> n && n != 0)
    {
        int sum = 0;
        for(int i = 1; i < n; i++)
        {
            if(n%i == 0) sum += i;
        }
        printf("%5d ", n);
        if(sum < n) cout << "DEFICIENT" << endl;
        if(sum > n) cout << "ABUNDANT" << endl;
        if(sum == n) cout << "PERFECT" << endl;
    }
    cout << "END OF OUTPUT" << endl;
    return 0;
}
