// Language Detection (UVA 12250)

#include <iostream>
#include <string>

using namespace std;

int main()
{
    string s;
    int num = 0;

    while(getline(cin, s)&& s != "#")
    {
        if(s == "HELLO") cout << "Case " << ++num << ": ENGLISH" << endl;
        else if(s == "HOLA") cout << "Case " << ++num << ": SPANISH" << endl;
        else if(s == "HALLO") cout << "Case " << ++num << ": GERMAN" << endl;
        else if(s == "BONJOUR") cout << "Case " << ++num << ": FRENCH" << endl;
        else if(s == "CIAO") cout << "Case " << ++num << ": ITALIAN" << endl;
        else if(s == "ZDRAVSTVUJTE") cout << "Case " << ++num << ": RUSSIAN" << endl;
        else cout << "Case " << ++num << ": UNKNOWN" << endl;
    }
    return 0;

}
