// Odd Sum (UVA 10783)

#include <iostream>

using namespace std;

int main()
{
    int n, count = 0;
    cin >> n;
    while(n--)
    {
        int a, b, sum = 0;
        cin >> a;
        cin >> b;

        for(int i = a; i <= b; i++)
        {
            if(i % 2 != 0) sum += i;
        }
        count++;
        cout << "Case " << count << ": " << sum << endl;
    }
}
