// Train Swapping (UVA 299)

#include <iostream>
#include <algorithm>

using namespace std;

int main(){

    int N;
    cin >> N;

    while(N--){
        int L;
        cin >> L;
        int train[55];
        for(int i = 0; i < L; i++){
            cin >> train[i];
        }
        int count = 0;

        // bubble sort
        for(int i = 0; i < L-1; i++){
            for(int j = 0; j < L-i-1; j++){
                if(train[j] > train[j+1]){
                    swap(train[j], train[j+1]);
                    count++;
                }
            }
        }
        cout << "Optimal train swapping takes " << count << " swaps." << endl;
    }
    return 0;
}
