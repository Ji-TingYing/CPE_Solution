//Vito's Family (UVA 10041)

#include <iostream>
#include <algorithm>

using namespace std;

int main()
{
    int T;

    cin >> T;

    while(T--){
        int r; 
        cin >> r;

        int s[r];

        for(int i = 0; i < r; i++){
            cin >> s[i];
        }
        sort(s, s+r); // 排序

        int sum = 0;

        for(int i = 0; i < r; i++){
            sum += abs(s[i]-s[r/2]); // s[r/2]求中位數，s[i]-s[r/2]是求老大到各個家的距離，兩者相減的差加起來即是答案
        }
        cout << sum << endl;
    }
}

