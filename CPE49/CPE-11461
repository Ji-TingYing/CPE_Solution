//Square Numbers  (UVA 11461)

#include <iostream>
#include <cmath>

using namespace std;

int main()
{
    int a, b, count = 0;

    while(cin >> a >> b)
    {
        if(a == 0 && b == 0) break;

        for(int i = a; i <= b; i++)
        {
            int x = sqrt(i);

            if(x * x == i) count++;
        }
        cout << count << endl;

    }
    return 0;
}

