// Power Crisis (UVA 151)

#include <iostream>

using namespace std;

bool check(int n, int m) {
    int last_powered = 0; 

    for (int i = 2; i <= n-1; ++i) {
       last_powered = (last_powered + m) % i; 
    }

    return last_powered == 11;
}

int main() {
    int n;

    while (cin >> n && n != 0) {
        
        int m = 1;

        while (!check(n, m)) {
            m++;
        }
        cout << m << "\n";
    }
    return 0;
}
